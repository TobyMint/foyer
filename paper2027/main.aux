\newlabel{tab:main}{{II}{8}{Three arms, same trace, engine, and memory budget. Round latency includes the controller's door wait and the engine's TTFT; the deadline is 10\,s per round. Work is uncached prefill plus completion tokens}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Decomposition. Busy and idle time are sampled from the engine's running-request count over each run's window. Prompt, device-hit and host-hit tokens are the engine's cumulative counters over the same window; uncached prefill, completion and the re-read tax are summed from the per-step records. Evicted tokens are what the engine had to throw away to make room.}}{8}{table.caption.4}\protected@file@percent }
\newlabel{tab:decomp}{{III}{8}{Decomposition. Busy and idle time are sampled from the engine's running-request count over each run's window. Prompt, device-hit and host-hit tokens are the engine's cumulative counters over the same window; uncached prefill, completion and the re-read tax are summed from the per-step records. Evicted tokens are what the engine had to throw away to make room}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Attribution of the re-read tax. Rounds are classified by what happened between the previous round and this one. \emph  {rounds} and \emph  {share} are percentages, \emph  {uncached} is in millions of tokens, and \emph  {excess} is uncached prefill divided by the tokens the round actually appended.}}{8}{table.caption.5}\protected@file@percent }
\newlabel{tab:attrib}{{IV}{8}{Attribution of the re-read tax. Rounds are classified by what happened between the previous round and this one. \emph {rounds} and \emph {share} are percentages, \emph {uncached} is in millions of tokens, and \emph {excess} is uncached prefill divided by the tokens the round actually appended}{table.caption.5}{}}
